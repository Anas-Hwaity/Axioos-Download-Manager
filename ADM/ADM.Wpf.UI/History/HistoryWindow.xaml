<Window x:Class="ADM.Wpf.UI.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ADM.Wpf.UI.History"
        Title="{StaticResource HISTORY_TITLE}"
        Width="1040" Height="650" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="HistoryWindow"
        Template="{StaticResource GlassWindowTemplate}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/GlassScrollChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HistoryFilterLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="2,0,0,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="HistoryFilterExample" TargetType="{x:Type TextBlock}">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="13,0,10,0"/>
                <Setter Property="Foreground" Value="{DynamicResource GlassMutedTextBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="16" Margin="0,0,0,10" Padding="12"
                Background="{DynamicResource GlassPanelSurfaceBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource HistoryFilterLabel}" Text="{StaticResource HISTORY_SEARCH_LABEL}"/>
                    <Grid>
                        <TextBox Style="{StaticResource GlassTextBox}" x:Name="SearchBox" Padding="10,7"
                                 KeyDown="Filter_KeyDown"
                                 AutomationProperties.AutomationId="HistorySearch"
                                 AutomationProperties.Name="{StaticResource HISTORY_SEARCH_LABEL}"
                                 ToolTip="{StaticResource HISTORY_SEARCH_HINT}"/>
                        <TextBlock Style="{StaticResource HistoryFilterExample}" Text="{StaticResource HISTORY_SEARCH_EXAMPLE}"
                                   Tag="{Binding Text, ElementName=SearchBox}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource HistoryFilterLabel}" Text="{StaticResource HISTORY_DOMAIN_LABEL}"/>
                    <Grid>
                        <TextBox Style="{StaticResource GlassTextBox}" x:Name="DomainBox" Padding="10,7"
                                 KeyDown="Filter_KeyDown"
                                 AutomationProperties.AutomationId="HistoryDomainFilter"
                                 AutomationProperties.Name="{StaticResource HISTORY_DOMAIN_LABEL}"
                                 ToolTip="{StaticResource HISTORY_DOMAIN_HINT}"/>
                        <TextBlock Style="{StaticResource HistoryFilterExample}" Text="{StaticResource HISTORY_DOMAIN_EXAMPLE}"
                                   Tag="{Binding Text, ElementName=DomainBox}"/>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="TagPanel" Grid.Column="2" Width="200" Margin="0,0,8,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource HistoryFilterLabel}" Text="{StaticResource HISTORY_TAG_LABEL}"/>
                    <ComboBox Style="{StaticResource GlassComboBox}" x:Name="TagBox"
                              SelectionChanged="TagBox_SelectionChanged"
                              AutomationProperties.AutomationId="HistoryTagFilter"
                              AutomationProperties.Name="{StaticResource HISTORY_TAG_LABEL}"
                              ToolTip="{StaticResource HISTORY_TAG_HINT}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Padding="14,7" Margin="0,0,6,0" Style="{StaticResource GlassToolbarActionButton}"
                            Content="{StaticResource HISTORY_APPLY_FILTERS}" Click="ApplyFilters_Click"
                            AutomationProperties.AutomationId="HistoryApplyFilters"/>
                    <Button Padding="14,7" Style="{StaticResource GlassToolbarActionButton}"
                            Content="{StaticResource HISTORY_CLEAR_FILTERS}" Click="ClearFilters_Click"
                            AutomationProperties.AutomationId="HistoryClearFilters"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" CornerRadius="16" Padding="1"
                Background="{DynamicResource GlassTableSurfaceBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
            <ListView x:Name="HistoryList"
                      ItemsSource="{Binding Items}"
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      AutomationProperties.AutomationId="HistoryList" ItemContainerStyle="{StaticResource DownloadListViewItemStyle}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource DownloadGridViewColumnHeaderStyle}">
                        <GridViewColumn Header="{StaticResource HISTORY_COL_NAME}" Width="280" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="{StaticResource HISTORY_COL_DATE}" Width="155" DisplayMemberBinding="{Binding DateAdded}"/>
                        <GridViewColumn Header="{StaticResource HISTORY_COL_SIZE}" Width="105" DisplayMemberBinding="{Binding Size}"/>
                        <GridViewColumn Header="{StaticResource HISTORY_COL_TYPE}" Width="100" DisplayMemberBinding="{Binding DownloadType}"/>
                        <GridViewColumn Header="{StaticResource HISTORY_COL_FILE}" Width="90" DisplayMemberBinding="{Binding FileExists}"/>
                        <GridViewColumn Header="{StaticResource HISTORY_COL_SOURCE}" Width="250" DisplayMemberBinding="{Binding SafeUrlDisplay}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="2" CornerRadius="14" Margin="0,10,0,0" Padding="10,7"
                Background="{DynamicResource GlassPanelSurfaceBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviousButton" Content="{StaticResource HISTORY_PREVIOUS}" Margin="0,0,8,0"
                        Padding="12,6" Style="{StaticResource GlassToolbarActionButton}"
                        IsEnabled="{Binding CanPrevious}" Click="Previous_Click"/>
                <Button x:Name="NextButton" Grid.Column="1" Content="{StaticResource HISTORY_NEXT}"
                        Padding="12,6" Style="{StaticResource GlassToolbarActionButton}"
                        IsEnabled="{Binding CanNext}" Click="Next_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0">
                    <Button Content="{StaticResource HISTORY_OPEN_FILE}" Margin="2" Padding="9,5" Style="{StaticResource GlassToolbarActionButton}" Click="OpenFile_Click"/>
                    <Button Content="{StaticResource HISTORY_OPEN_FOLDER}" Margin="2" Padding="9,5" Style="{StaticResource GlassToolbarActionButton}" Click="OpenFolder_Click"/>
                    <Button Content="{StaticResource HISTORY_COPY_SAFE_URL}" Margin="2" Padding="9,5" Style="{StaticResource GlassToolbarActionButton}" Click="CopySafeUrl_Click"/>
                    <Button Content="{StaticResource HISTORY_COPY_FULL_URL}" Margin="2" Padding="9,5" Style="{StaticResource GlassToolbarActionButton}" Click="CopyFullUrl_Click"/>
                    <Button Content="{StaticResource HISTORY_DOWNLOAD_AGAIN}" Margin="2" Padding="9,5" Style="{StaticResource GlassToolbarActionButton}" Click="DownloadAgain_Click"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource GlassTextBrush}" Text="{Binding TotalCount, StringFormat={}{0} items}"/>
                </StackPanel>
                <ProgressBar Grid.Column="3" Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
