<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="LegacyGlassTabControlBase"
           TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBordercolor}"/>
    </Style>
    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource LegacyGlassTabControlBase}"/>

    <Style x:Key="LegacyGlassTabItemBase"
           TargetType="{x:Type TabItem}"
           BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForecolor}"/>
        <Setter Property="Margin" Value="0,0,6,8"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CategoryMouseOverBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonFocusedBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForecolor}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource CategoryHighlight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonFocusedBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForecolor}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ControlDisabledBackcolor}"/>
                <Setter Property="Opacity" Value="0.48"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource LegacyGlassTabItemBase}"/>
</ResourceDictionary>
