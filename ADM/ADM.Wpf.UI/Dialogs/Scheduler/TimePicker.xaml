<UserControl x:Class="ADM.Wpf.UI.Dialogs.Scheduler.TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADM.Wpf.UI.Dialogs.Scheduler"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="120" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ComboBox Style="{StaticResource GlassComboBox}" Name="CmbHour" HorizontalAlignment="Stretch" MinWidth="76" Width="76" Padding="12,6,28,6"/>
        <TextBlock Text=":" Margin="6,0" VerticalAlignment="Center" Grid.Column="1"/>
        <ComboBox Style="{StaticResource GlassComboBox}" Name="CmbMinute" Grid.Column="2" HorizontalAlignment="Stretch" MinWidth="76" Width="76" Padding="12,6,28,6" ItemStringFormat="D2"/>
        <TextBlock Text=":" Margin="6,0" VerticalAlignment="Center" Grid.Column="3"/>
        <ComboBox Style="{StaticResource GlassComboBox}" Name="CmbAmPm"  Grid.Column="4" HorizontalAlignment="Stretch" MinWidth="76" Width="76" Padding="12,6,28,6">
            <ComboBoxItem>AM</ComboBoxItem>
            <ComboBoxItem>PM</ComboBoxItem>
        </ComboBox>
    </Grid>
</UserControl>
