<Window x:Class="ADM.Wpf.UI.Dialogs.NewDownload.NewDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADM.Wpf.UI.Dialogs.NewDownload"
        mc:Ignorable="d"
        Title="{StaticResource ND_TITLE}" Height="340" Width="660" Topmost="True"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown" ShowInTaskbar="False" AutomationProperties.AutomationId="DownloadFileInfoWindow" Template="{StaticResource GlassWindowTemplate}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/GlassScrollChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ContextMenu x:Key="DownloadLaterContextMenu"></ContextMenu>
            <MenuItem Style="{StaticResource GlassLeafMenuItem}" x:Key="DontAddToQueueMenuItem" Header="{StaticResource LBL_QUEUE_OPT3}" Click="DontAddToQueueMenuItem_Click"/>
            <MenuItem Style="{StaticResource GlassLeafMenuItem}" x:Key="QueueAndSchedulerMenuItem" Header="{StaticResource DESC_Q_TITLE}" Click="QueueAndSchedulerMenuItem_Click"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource GlassPanelSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18,16,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource ND_ADDRESS}"
                       Margin="0,7,10,7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBox Style="{StaticResource GlassTextBox}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Name="TxtUrl" AutomationProperties.AutomationId="DownloadUrlInput"
                     Margin="0,2,0,4" MinHeight="28" VerticalContentAlignment="Center"
                     TextChanged="TxtUrl_TextChanged"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource MSG_CATEGORY}"
                       Margin="0,7,10,7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                    Margin="0,2,0,4" MinHeight="28" Padding="7,4"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Background="{DynamicResource GlassInputBrush}">
                <TextBlock Name="TxtCategory" Text="---" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource ND_FILE}"
                       Margin="0,7,10,7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBox Style="{StaticResource GlassTextBox}" Grid.Row="2" Grid.Column="1" Name="TxtFile" AutomationProperties.AutomationId="DownloadFileInput"
                     Margin="0,2,8,4" MinHeight="28" VerticalContentAlignment="Center"
                     TextChanged="TxtFile_TextChanged"/>
            <Path Grid.Row="2" Grid.Column="2" Margin="3,2,8,4"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  StrokeThickness="0" Stretch="Uniform"
                  Fill="{DynamicResource ToolButtonMouseDisabledForecolor}"
                  Width="28" Height="28" Data="{StaticResource ri-file-download-line}"
                  SnapsToDevicePixels="True"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Name="TxtFileSize" Text="---"
                       Margin="0,7,0,7" HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{StaticResource LBL_SAVE_IN}"
                       Margin="0,7,10,7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <ComboBox Style="{StaticResource GlassComboBox}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Name="CmbLocation" AutomationProperties.AutomationId="DownloadLocationInput"
                      Margin="0,2,0,4" MinHeight="28" VerticalContentAlignment="Center"
                      SelectionChanged="CmbLocation_SelectionChanged"/>

            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="{StaticResource ND_IGNORE_URL}" Margin="0,9,0,0"
                       Cursor="Hand" MouseDown="TextBlock_MouseDown"
                       Foreground="{DynamicResource HyperlinkForecolor}"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource GlassPanelSurfaceStrongBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Name="btnAdvanced" AutomationProperties.AutomationId="DownloadMoreButton" Content="{StaticResource ND_MORE}"
                        MinWidth="82" Padding="14,6" Margin="0,0,8,0"
                        Click="btnAdvanced_Click"/>
                <Button Grid.Column="2" Name="btnDownloadLater" AutomationProperties.AutomationId="DownloadLaterButton" Content="{StaticResource ND_DOWNLOAD_LATER}"
                        MinWidth="112" Padding="14,6" Margin="8,0,0,0"
                        Click="btnDownloadLater_Click"/>
                <Button Grid.Column="3" Name="btnDownload" AutomationProperties.AutomationId="StartDownloadButton" Content="{StaticResource ND_DOWNLOAD_NOW}"
                        MinWidth="112" Padding="14,6" Margin="8,0,0,0"
                        IsDefault="True" Click="btnDownload_Click"/>
                <Button Grid.Column="4" Name="btnCancel" AutomationProperties.AutomationId="DownloadCancelButton" Content="{StaticResource ND_CANCEL}"
                        MinWidth="92" Padding="14,6" Margin="8,0,0,0"
                        Click="btnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
