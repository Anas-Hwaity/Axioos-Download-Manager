<UserControl x:Class="ADM.Wpf.UI.Dialogs.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADM.Wpf.UI.Dialogs.Settings"
             mc:Ignorable="d" 
             AutomationProperties.AutomationId="GeneralSettingsView"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:CategoryFileTypesConverter x:Key="CategoryFileTypesConverter"></local:CategoryFileTypesConverter>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock Padding="10" Text="{StaticResource SETTINGS_GENERAL}" DockPanel.Dock="Top" FontSize="14"/>
        <ScrollViewer Margin="0,10,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox Name="ChkShowPrg" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" 
                          VerticalContentAlignment="Center" Margin="10,5" Padding="3" 
                          Content="{StaticResource SHOW_DWN_PRG}" IsChecked="{Binding ShowProgressWindow}"/>
                <CheckBox Name="ChkShowComplete" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" 
                          VerticalContentAlignment="Center" Margin="10,5" Padding="3" Content="{StaticResource SHOW_DWN_COMPLETE}" IsChecked="{Binding ShowDownloadCompleteWindow}"/>
                <CheckBox Name="ChkStartAuto" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" VerticalContentAlignment="Center" 
                          Margin="10,5" Padding="3" Content="{StaticResource LBL_START_AUTO}" IsChecked="{Binding StartDownloadAutomatically}"/>
                <CheckBox Name="ChkOverwrite" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" VerticalContentAlignment="Center" 
                          Margin="10,5" Padding="3" Content="{StaticResource LBL_OVERWRITE_EXISTING}" IsChecked="{Binding OverwriteExistingFiles}"/>
                <TextBlock Margin="10" Text="{StaticResource MSG_DOUBLE_CLICK_ACTION}" VerticalAlignment="Center" Grid.Row="4"  Grid.ColumnSpan="2" />
                <StackPanel Margin="10" Grid.Row="4"  Grid.ColumnSpan="2" Grid.Column="2">
                    <ComboBox Style="{StaticResource GlassComboBox}" Grid.Row="8" Name="CmbDblClickAction" HorizontalAlignment="Right"
                              VerticalAlignment="Center" MinWidth="150" SelectedIndex="{Binding DoubleClickActionIndex}" Foreground="{DynamicResource GlassTextBrush}" Background="{DynamicResource GlassInputBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                        <ComboBoxItem Content="{StaticResource CTX_OPEN_FOLDER}"/>
                        <ComboBoxItem Content="{StaticResource MSG_OPEN_FILE}"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Margin="10,10,10,0" Text="{StaticResource LBL_TEMP_FOLDER}" Grid.Row="5" Grid.ColumnSpan="4" />
                <TextBox Style="{StaticResource GlassTextBox}" Name="TxtTempFolder" Grid.Row="6" Grid.Column="0" Margin="10" VerticalContentAlignment="Center"
                         AcceptsReturn="False" TextWrapping="NoWrap" Grid.ColumnSpan="3" IsReadOnly="True" Text="{Binding TempFolder}" Foreground="{DynamicResource GlassTextBrush}" Background="{DynamicResource GlassInputBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"/>
                <Button Name="BtnTempFolderBrowse"  Grid.Row="6" Grid.Column="3" Margin="0,10,10,10" Padding="5,3" Content="..." Click="BtnTempFolderBrowse_Click"/>
                <TextBlock Margin="10,10,10,0" Text="{StaticResource SETTINGS_FOLDER}" Grid.Row="7" Grid.ColumnSpan="4" />
                <TextBox Style="{StaticResource GlassTextBox}" Name="TxtDownloadFolder" Grid.Row="8" Grid.Column="0" Margin="10" VerticalContentAlignment="Center"
                         AcceptsReturn="False" TextWrapping="NoWrap" Grid.ColumnSpan="3" IsReadOnly="True" Text="{Binding DefaultDownloadFolder}" Foreground="{DynamicResource GlassTextBrush}" Background="{DynamicResource GlassInputBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"/>
                <Button Name="BtnDownloadFolderBrowse"  Grid.Row="8" Grid.Column="3" Margin="0,10,10,10" Padding="3" Content="..." Click="BtnDownloadFolderBrowse_Click" />
                <TextBlock Margin="10" Text="{StaticResource MSG_MAX_DOWNLOAD}" VerticalAlignment="Center" Grid.Row="9"  Grid.ColumnSpan="2" />
                <StackPanel Margin="10" Grid.Row="9"  Grid.ColumnSpan="2" Grid.Column="2">
                    <ComboBox Style="{StaticResource GlassComboBox}" Grid.Row="8" Name="CmbMaxParallalDownloads" HorizontalAlignment="Right"
                              VerticalAlignment="Center" ItemsSource="{Binding MaxParallelDownloadOptions}" SelectedItem="{Binding MaxParallelDownloads}" Foreground="{DynamicResource GlassTextBrush}" Background="{DynamicResource GlassInputBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"/>
                </StackPanel>
                <CheckBox Name="ChkDarkTheme" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4" VerticalContentAlignment="Center" 
                          Margin="10,5" Padding="3" Content="{StaticResource SETTINGS_DARK_THEME}" IsChecked="{Binding AllowSystemDarkTheme}"/>
                <CheckBox Name="ChkAutoCat" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="4" VerticalContentAlignment="Center" 
                          Margin="10,5" Padding="3" Content="{StaticResource SETTINGS_ATUO_CAT}" IsChecked="{Binding AutomaticCategorySelection}"/>
                <Grid Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="4" Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{StaticResource SETTINGS_GLASS_LEVEL}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Name="SldGlassmorphism" AutomationProperties.AutomationId="GlassmorphismLevelSlider"
                                AutomationProperties.Name="{StaticResource SETTINGS_GLASS_LEVEL}"
                                AutomationProperties.HelpText="0 turns the moving glass panels off; 50 is balanced; 100 shows the full animated panel field and glass depth"
                                ToolTip="0 = flat/solid, 50 = subtle panels, 100 = full panel depth" Width="220"
                                Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                Value="{Binding GlassmorphismLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="10,0,0,0" MinWidth="42" VerticalAlignment="Center" TextAlignment="Right"
                                   AutomationProperties.AutomationId="GlassmorphismLevelValue"
                                   Text="{Binding GlassmorphismLevel, StringFormat={}{0}%}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Margin="10,15,10,5" Text="{StaticResource SETTINGS_CAT}" Grid.Row="13" Grid.ColumnSpan="4" />
                <ListView Margin="10,5" Name="LvCategories" Grid.ColumnSpan="4" Grid.Row="14"
                          Style="{StaticResource DownloadListViewStyle}"
                          BorderBrush="{DynamicResource GlassBorderStrongBrush}" Background="{DynamicResource GlassTableSurfaceBrush}"
                          Foreground="{DynamicResource GlassTextBrush}" ItemsSource="{Binding Categories}" ItemContainerStyle="{StaticResource DownloadListViewItemStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource DownloadGridViewColumnHeaderStyle}">
                            <GridViewColumn Header="{StaticResource SETTINGS_CAT_NAME}" Width="120" DisplayMemberBinding="{Binding DisplayName}" />
                            <GridViewColumn Header="{StaticResource SETTINGS_CAT_TYPES}" Width="150" DisplayMemberBinding="{Binding FileExtensions, Converter={StaticResource CategoryFileTypesConverter}}" />
                            <GridViewColumn Header="{StaticResource SETTINGS_CAT_FOLDER}" Width="150" DisplayMemberBinding="{Binding DefaultFolder}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Margin="10,0" Grid.Row="15" Grid.ColumnSpan="4" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Name="CatAdd" Style="{StaticResource GlassToolbarActionButton}" Margin="5" Padding="10,3" Content="{StaticResource SETTINGS_CAT_ADD}" Click="CatAdd_Click"/>
                    <Button Name="CatEdit" Style="{StaticResource GlassToolbarActionButton}" Margin="5" Padding="10,3" Content="{StaticResource SETTINGS_CAT_EDIT}" Click="CatEdit_Click"/>
                    <Button Name="CatDel" Style="{StaticResource GlassToolbarActionButton}" Margin="5" Padding="10,3" Content="{StaticResource DESC_DEL}" Click="CatDel_Click"/>
                    <Button Name="CatDef" Style="{StaticResource GlassToolbarActionButton}" Margin="5" Padding="10,3" Content="{StaticResource DESC_DEF}" Click="CatDef_Click"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
