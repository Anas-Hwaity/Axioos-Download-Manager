<Window x:Class="ADM.Wpf.UI.Dialogs.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADM.Wpf.UI.Dialogs.Settings"
        mc:Ignorable="d"
        AutomationProperties.AutomationId="SettingsWindow"
        Title="{StaticResource TITLE_SETTINGS}" Height="560" Width="800" MinHeight="520" MinWidth="740" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Template="{StaticResource GlassWindowTemplate}">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/GlassScrollChrome.xaml"/>
    </Window.Resources>
    <Grid Background="Transparent" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="4" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="-10" CacheMode="BitmapCache">
            <Ellipse Width="450" Height="450" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,-180,0" Fill="{DynamicResource GlassAuroraCyanBrush}" Opacity="0.18"/>
            <Ellipse Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-210,0,0,-270" Fill="{DynamicResource GlassAuroraPurpleBrush}" Opacity="0.14"/>
        </Grid>
        <Button  Grid.Row="1" Grid.Column="2" Margin="0,10,10,10" Padding="10,3" Content="{StaticResource DESC_SAVE_Q}" Name="BtnOK" Style="{StaticResource GlassToolbarActionButton}" AutomationProperties.AutomationId="SettingsSaveButton" Command="{Binding SaveCommand}"/>
        <Button  Grid.Row="1" Grid.Column="3" Margin="0,10,10,10" Padding="10,3" Content="{StaticResource ND_CANCEL}" Name="BtnCancel" Style="{StaticResource GlassToolbarActionButton}" AutomationProperties.AutomationId="SettingsCancelButton" Click="BtnCancel_Click"/>
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                Margin="0,0,16,0" Padding="9"
                Background="{DynamicResource GlassPanelSurfaceBrush}"
                BorderBrush="{DynamicResource GlassBorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <ListBox Name="LbTitles"
                     SelectionChanged="LbTitles_SelectionChanged"
                     Padding="0"
                     BorderThickness="0"
                     Background="{x:Null}"
                     ItemContainerStyle="{StaticResource GlassSettingsNavItem}">
                <ListBoxItem>
                    <TextBlock Padding="10,10,20,10" Text="{StaticResource SETTINGS_MONITORING}"/>
                </ListBoxItem>
                <ListBoxItem>
                    <TextBlock Padding="10,10,20,10" Text="{StaticResource SETTINGS_GENERAL}"/>
                </ListBoxItem>
                <ListBoxItem>
                    <TextBlock Padding="10,10,20,10" Text="{StaticResource SETTINGS_NETWORK}"/>
                </ListBoxItem>
                <ListBoxItem>
                    <TextBlock Padding="10,10,20,10" Text="{StaticResource SETTINGS_CRED}"/>
                </ListBoxItem>
                <ListBoxItem>
                    <TextBlock Padding="10,10,20,10" Text="{StaticResource SETTINGS_ADV}"/>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Appearance">
                    <TextBlock Padding="10,10,20,10" Text="{StaticResource SETTINGS_APPEARANCE}"/>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Download rules">
                    <TextBlock Padding="10,10,20,10" Text="Download rules"/>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Diagnostics">
                    <TextBlock Padding="10,10,20,10" Text="Diagnostics"/>
                </ListBoxItem>
            </ListBox>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4" Background="{DynamicResource GlassPanelSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderStrongBrush}" BorderThickness="1" CornerRadius="16" Padding="10" Effect="{DynamicResource GlassCardShadow}">
            <Grid>
                <local:BrowserMonitoringView x:Name="BrowserMonitoringView" Background="Transparent" AutomationProperties.AutomationId="BrowserMonitoringView"/>
                <local:GeneralSettingsView x:Name="GeneralSettingsView" Background="Transparent" Margin="14,8,12,4"/>
                <local:NetworkSettingsView x:Name="NetworkSettingsView" Background="Transparent" Margin="14,8,12,4"/>
                <local:PasswordManagerView x:Name="PasswordManagerView" Background="Transparent" Margin="14,8,12,4"/>
                <local:AdvancedSettingsView x:Name="AdvancedSettingsView" Background="Transparent" Margin="14,8,12,4"/>
                <local:AppearanceSettingsView x:Name="AppearanceSettingsView" Background="Transparent" Margin="14,8,12,4"/>
                <local:RulesView x:Name="RulesView" Background="Transparent" Margin="14,8,12,4"/>
                <local:DiagnosticsView x:Name="DiagnosticsView" Background="Transparent" Margin="14,8,12,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
