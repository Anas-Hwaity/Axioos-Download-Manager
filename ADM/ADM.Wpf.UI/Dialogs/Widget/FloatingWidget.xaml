<Window x:Class="ADM.Wpf.UI.Dialogs.Widget.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ADM.Wpf.UI.Dialogs.Widget"
        mc:Ignorable="d"
        Title="FloatingWidget" Height="40" Width="200" WindowStyle="None" MouseDown="Window_MouseDown" 
        BorderThickness="0" ResizeMode="NoResize"
        ShowInTaskbar="False" Padding="10,0,0,0" Background="{StaticResource FloatingWidgetBackgroundBrush}" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual" Template="{StaticResource GlassWindowTemplate}">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/GlassScrollChrome.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Padding="5,2" Name="TxtHelp" Text="DOWNLOAD VIDEO" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource FloatingWidgetTextBrush}" FontSize="14" Cursor="Hand"/>
        <Path Grid.Column="4"
                                    Height="10"
                                    Width="10"
                                    VerticalAlignment="Center" 
                                    StrokeThickness="0"
                                    Stretch="Fill" 
                                    Fill="{DynamicResource StatusbarIconcolor}"
                                    Stroke="{DynamicResource StatusbarIconcolor}" 
                                    Data="{StaticResource ri-close-fill}"
                                    SnapsToDevicePixels="True"
                                    Margin="0,5,10,5" Cursor="Hand"/>
    </Grid>
</Window>
