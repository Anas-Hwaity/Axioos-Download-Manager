<Window x:Class="ADM.Wpf.UI.Dialogs.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AutomationProperties.AutomationId="AboutWindow"
        Title="{StaticResource MENU_ABOUT}" Height="620" Width="520" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Template="{StaticResource GlassWindowTemplate}">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/GlassScrollChrome.xaml"/>
    </Window.Resources>
    <Grid Margin="18">
        <TabControl AutomationProperties.AutomationId="AboutTabs">
        <TabItem Header="About" AutomationProperties.AutomationId="AboutTabAbout">
        <Border Background="{DynamicResource GlassPanelSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderStrongBrush}"
                BorderThickness="1" CornerRadius="20" Padding="26,24" Effect="{DynamicResource GlassCardShadow}">
            <StackPanel HorizontalAlignment="Stretch">
                <Border Width="96" Height="96" CornerRadius="26" HorizontalAlignment="Center"
                        Background="{StaticResource AxioosLogoTileBrush}" AutomationProperties.Name="Axioos logo">
                    <Viewbox Margin="6">
                        <Canvas Width="64" Height="64">
                            <Path Data="{StaticResource AxioosLogoGeometry}" Fill="{StaticResource AxioosLogoInkBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Name="TxtAppVersion" Margin="0,16,0,2" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Name="TxtBaseVersion" HorizontalAlignment="Center" Foreground="{DynamicResource GlassMutedTextBrush}" FontSize="11.5"/>
                <TextBlock Name="TxtMSIXInfo" HorizontalAlignment="Center" Foreground="{DynamicResource GlassMutedTextBrush}" FontSize="11.5"/>
                <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="14"
                        Background="{DynamicResource GlassAccentSoftBrush}" BorderBrush="{DynamicResource GlassBorderStrongBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="DEVELOPED BY" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource GlassMutedTextBrush}"/>
                        <TextBlock Name="TxtDeveloper" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Button Name="BtnTelegram" Margin="0,12,0,0" Padding="14,9" HorizontalContentAlignment="Left"
                        Style="{StaticResource GlassToolbarActionButton}" Click="BtnTelegram_Click"
                        AutomationProperties.AutomationId="AboutTelegramButton">
                    <StackPanel>
                        <TextBlock Text="TELEGRAM" FontSize="10.5" Foreground="{DynamicResource GlassMutedTextBrush}"/>
                        <TextBlock Name="TxtTelegram" FontSize="13.5"/>
                    </StackPanel>
                </Button>
                <Button Name="BtnGitHub" Margin="0,8,0,0" Padding="14,9" HorizontalContentAlignment="Left"
                        Style="{StaticResource GlassToolbarActionButton}" Click="BtnGitHub_Click"
                        AutomationProperties.AutomationId="AboutGitHubButton">
                    <StackPanel>
                        <TextBlock Text="GITHUB" FontSize="10.5" Foreground="{DynamicResource GlassMutedTextBrush}"/>
                        <TextBlock Name="TxtWebsite" FontSize="13.5"/>
                    </StackPanel>
                </Button>
                <TextBlock Name="TxtCopyright" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="11.5" Foreground="{DynamicResource GlassMutedTextBrush}"/>
                <TextBlock Name="TxtOSInfo" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource GlassMutedTextBrush}"/>
                <TextBlock Name="TxtNetFxInfo" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource GlassMutedTextBrush}"/>
            </StackPanel>
        </Border>
        </TabItem>
        <TabItem Header="What Axioos adds" AutomationProperties.AutomationId="AboutTabProgram">
            <Border Background="{DynamicResource GlassPanelSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="20" Padding="20,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="NotesPanel"/>
                </ScrollViewer>
            </Border>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
