{
    "name": "Axioos Integration Module",
    "action": {},
    "manifest_version": 3,
    "version": "1.0.3",
    "description": "Download with Axioos Download Manager.",
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "downloads",
        "cookies",
        "webRequest",
        "webNavigation",
        "tabs",
        "storage",
        "contextMenus",
        "alarms",
        "nativeMessaging"
    ],
    "background": {
        "service_worker": "main.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "social-site-policy-core.js",
                "media-identity-core.js",
                "video-overlay-core.js",
                "extension-theme.js",
                "video-overlay-view.js",
                "video-overlay.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "key": ""
}
