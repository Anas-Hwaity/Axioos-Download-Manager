<?xml version="1.0" encoding="UTF-8"?>
<?define ProductVersion = "$(env.BUILD_VER)"?>
<?define ProductUpgradeCode="$(env.PRODUCT_UPGRADE_CODE)"?>
<?ifdef env.LEGACY_UPGRADE_CODE?>
<?define LegacyUpgradeCode="$(env.LEGACY_UPGRADE_CODE)"?>
<?else?>
<?define LegacyUpgradeCode="3E462F34-3D19-4247-AD64-1B74703555D6"?>
<?endif?>
<?ifndef CabCompression?>
<?define CabCompression="high"?>
<?endif?>
<?include ProductIdentity.wxi?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"  xmlns:ui="http://schemas.microsoft.com/wix/UIExtension">
  <Product Id="*" Name="$(var.ProductDisplayName)" Codepage="utf-32" Language="1033" Version="$(var.ProductVersion)" Manufacturer="Anas Al Hwaity" UpgradeCode="$(var.ProductUpgradeCode)">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade AllowDowngrades="yes"
                  Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="no" />

    <Upgrade Id="$(var.LegacyUpgradeCode)">
      <UpgradeVersion Minimum="1.0.0" IncludeMinimum="yes" Maximum="1.0.1" IncludeMaximum="yes" Property="AXIOOSLEGACYFOUND" />
    </Upgrade>
	
	<Condition Message="Axioos needs Windows 10 or newer.">
		<![CDATA[Installed OR (VersionNT > 602)]]>
	</Condition>
	
	<Property Id="ARPPRODUCTICON" Value="AppIcon" />
	<Property Id="ARPURLINFOABOUT" Value="https://github.com/Anas-Hwaity/Axioos-Download-Manager" />
	<Property Id="ARPHELPLINK" Value="https://github.com/Anas-Hwaity/Axioos-Download-Manager/issues" />
	<Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open $(var.ProductDisplayName)" />
	<Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
	
	<WixVariable Id="WixUILicenseRtf" Value="gpl-2.0.rtf" />
	<Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
	
	<UI>
        <UIRef Id="WixUI_InstallDir" />
        <Publish Dialog="ExitDialog" 
            Control="Finish" 
            Event="DoAction" 
            Value="LaunchADM">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>
	
    <MediaTemplate EmbedCab="yes" CompressionLevel="$(var.CabCompression)"  />
	
	<Feature Id="ProductFeature" Title="ADM" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
	  <ComponentGroupRef Id="NET4" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ProgramShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <CustomAction Id="LaunchADM"  Directory="INSTALLFOLDER" ExeCommand='"[INSTALLFOLDER]$(var.AppExeName)" --first-run'  Return="asyncNoWait" Impersonate="yes"/>

  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Axioos">
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder"/>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuSubFolder" Name="$(var.ProductDisplayName)"></Directory>
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
	  <Component Id="RegistryEntries" Guid="*">
        <RegistryKey Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run">
            <RegistryValue Type="string" Name="ADM" Value='"[INSTALLFOLDER]$(var.AppExeName)" --background'/>
        </RegistryKey>
		<RegistryKey Root="HKCR"
                     Key="$(var.CustomProtocolScheme)">
            <RegistryValue Type="string" Value='URL:Axioos Download Manager'/>
			<RegistryValue Type="string" Name='URL Protocol' Value='' />
        </RegistryKey>
		<RegistryKey Root="HKCR"
                     Key="$(var.CustomProtocolScheme)\shell\open\command">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]$(var.AppExeName)" "%1"'/>
        </RegistryKey>
		<RegistryKey Root="HKCU"
                     Key="Software\Google\Chrome\NativeMessagingHosts\$(var.ChromeNativeHostName)">
            <RegistryValue Type="string" Value='[INSTALLFOLDER]ADM.App.Host\$(var.ChromeNativeHostName).json'/>
        </RegistryKey>
		<RegistryKey Root="HKCU"
                     Key="Software\Microsoft\Edge\NativeMessagingHosts\$(var.ChromeNativeHostName)">
            <RegistryValue Type="string" Value='[INSTALLFOLDER]ADM.App.Host\$(var.ChromeNativeHostName).json'/>
        </RegistryKey>
		<RegistryKey Root="HKCU"
                     Key="Software\Chromium\NativeMessagingHosts\$(var.ChromeNativeHostName)">
            <RegistryValue Type="string" Value='[INSTALLFOLDER]ADM.App.Host\$(var.ChromeNativeHostName).json'/>
        </RegistryKey>
    </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Icon Id="AppIcon" SourceFile="icon.ico"/>
    <DirectoryRef Id="ProgramMenuSubFolder">
      <Component Id="StartMenuShortcut" Guid="e2010274-669f-4c64-a7d2-9ac3d507c7ee">
        <Shortcut Id="AppStartMenuShortcut" Name="$(var.ProductDisplayName)" Icon="AppIcon" WorkingDirectory="INSTALLFOLDER" Target='[INSTALLFOLDER]$(var.AppExeName)'  Advertise="no"></Shortcut>
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductDisplayName)" Name="Installed1" Type="integer" Value="1" KeyPath="yes"/>
        <RemoveFolder Id="ProgramMenuSubFolder" On="uninstall"/>
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ProgramShortcut" Guid="5fd8abf9-1c16-426e-b069-abc5d3b23e6b">
        <Shortcut Id="AppShortcut" Name="$(var.ProductDisplayName)" Icon="AppIcon" WorkingDirectory="INSTALLFOLDER" Target='[INSTALLFOLDER]$(var.AppExeName)'  Advertise="no"></Shortcut>
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductDisplayName)" Name="Installed2" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="e557c047-0aef-44ea-b7dc-494974be6ad1">
        <Shortcut Id="AppDesktopShortcut"  Name="$(var.ProductDisplayName)" Icon="AppIcon" WorkingDirectory="INSTALLFOLDER" Target='[INSTALLFOLDER]$(var.AppExeName)'  Advertise="no"></Shortcut>
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductDisplayName)" Name="Installed3" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
  </Fragment>

</Wix>
